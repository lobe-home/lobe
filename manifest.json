{
  "manifest_version": 3,
  "name": "OutSystems Browser Enhancements",
  "version": "0.1.0",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "description": "A community collection of small enhancements for OutSystems platform frontends (Service Center, Lifetime, Community pages, etc.). Each enhancement is self-contained and easy to review.",
  "permissions": ["storage", "activeTab", "clipboardWrite", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "src/background.js" },
  "web_accessible_resources": [
    { "resources": ["assets/lobe.svg"], "matches": ["https://*/*"] }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OutSystems Browser Enhancements",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.outsystemscloud.com/*",
        "https://*.outsystemsenterprise.com/*",
        "https://*.outsystems.com/*",
        "https://*.outsystems.dev/*"
      ],
      "js": [
        "src/registry.js",
        "src/categories.js",
        "src/enhancements/o11-service-center/widen-rest-api-base-url.js",
        "src/enhancements/o11-service-center/copy-rest-webreference-base-url.js",
        "src/enhancements/o11-service-center/copy-url-in-table-cells.js",
        "src/enhancements/o11-service-center/quick-range-log-filters.js",
        "src/enhancements/o11-service-center/general-logs-filter-maxlength.js",
        "src/enhancements/odc-portal/avatar-group-role-summary.js",
        "src/enhancements/outsystems-forums/hide-forum-2026-bg-sections.js",
        "src/enhancements/outsystems-forums/hide-ranking.js",
        "src/enhancements/outsystems-forums/hide-nonpublic-neo-contributions.js",
        "src/runner.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
